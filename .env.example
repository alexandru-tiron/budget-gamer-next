# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
# A Neon URL (*.neon.tech) uses Neon's HTTP driver; anything else, such as the
# local Postgres from ./start-database.sh, uses a regular Postgres connection.
DATABASE_URL="postgresql://postgres:password@localhost:5432/budget-gamer-next"

# Password for the Postgres container in compose.yaml (`docker compose up -d db`).
# Development value only; use a strong one when self-hosting.
POSTGRES_PASSWORD="password"

# Optional: force the database driver ("neon-http" or "postgres")
# DATABASE_DRIVER="postgres"

# Optional: local database for `npm run test:db` and `npm run test:e2e`.
# Tests delete its data, so it must be on localhost.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/budget_gamer_test"

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# Reddit API token
REDDIT_AUTH_TOKEN="your_reddit_auth_token"

# Cron secret (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="your_cron_secret"

# Optional: Chromium pack used by the scrapers in production (defaults to the
# @sparticuz/chromium v153 x64 pack on GitHub)
# CHROMIUM_PACK_URL="https://github.com/Sparticuz/chromium/releases/download/v153.0.0/chromium-v153.0.0-pack.x64.tar"

# Optional: minimum server log level (debug, info, warn or error). Defaults to
# "info" in production and "debug" in development.
# LOG_LEVEL="info"
