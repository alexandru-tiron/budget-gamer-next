# Copy to secret.env (never commit it), fill in real values, then:
#   kubectl -n budget-gamer create secret generic budget-gamer --from-env-file=secret.env
DATABASE_URL=postgresql://user:password@your-database-host:5432/budget-gamer-next?sslmode=require
CRON_SECRET=generate-a-long-random-string
REDDIT_AUTH_TOKEN=your-reddit-auth-token
