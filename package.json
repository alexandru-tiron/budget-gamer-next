{
  "name": "budget-gamer-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/server/db/database.db.test.ts",
    "test:e2e": "playwright test",
    "e2e:prepare": "tsx e2e/prepare-db.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@sparticuz/chromium-min": "^153.0.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "link-preview-js": "^5.0.1",
    "next": "^16.4.2",
    "postgres": "^3.4.5",
    "puppeteer-core": "^25.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "puppeteer": "^25.14.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^5.0.5"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@11.1.0",
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
